# ============================================================
#  TileKick — Variables de entorno
#  Copia este archivo como .env para desarrollo local.
#  En Railway, configura estas variables en el dashboard.
# ============================================================

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
# Puerto local (Railway asigna PORT automáticamente, no lo toques en prod)
PORT=3000

# URL pública de la app — ¡IMPORTANTE cambiar en producción!
# Local:    http://localhost:3000
# Railway:  https://tu-app.up.railway.app
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# BASE DE DATOS (MySQL)
# ------------------------------------------------------------
# Local:    valores de tu MySQL local
# Railway:  Railway los inyecta automáticamente si usas el plugin MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tilekick

# ------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS (avatares)
# ------------------------------------------------------------
# Local:    vacío = usa ./storage (relativo al proyecto)
# Railway:  ruta del Volume montado, ej: /data
# Asegúrate de montar el Volume en Railway en esta misma ruta.
STORAGE_PATH=

# ------------------------------------------------------------
# AUTENTICACIÓN JWT
# ------------------------------------------------------------
TOKEN_SECRET=cambia_esto_por_una_clave_segura_larga
SALT_ROUNDS=11

# ------------------------------------------------------------
# OAUTH — Google
# Consola: https://console.cloud.google.com/
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# OAUTH — Facebook
# Consola: https://developers.facebook.com/
# ------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------
# OAUTH — GitHub
# Consola: https://github.com/settings/developers
# ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------
# EMAIL (Gmail SMTP)
# Requiere "Contraseña de aplicación" con 2FA activado en Gmail.
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME=TileKick
